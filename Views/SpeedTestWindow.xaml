<Window x:Class="TrafficMonitor.Views.SpeedTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SpeedTest_Title}"
        Width="680" Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FlowDirection="{DynamicResource ApplicationFlowDirection}"
        TextElement.FontFamily="{DynamicResource GlobalFontFamily}"
        TextOptions.TextFormattingMode="Display">

    <!-- ============================================ -->
    <!-- WINDOW RESOURCES                             -->
    <!-- ============================================ -->
    <Window.Resources>

        <!-- GRADIENTS -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0EA5E9" Offset="0"/>
            <GradientStop Color="#0284C7" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#22C55E" Offset="0"/>
            <GradientStop Color="#16A34A" Offset="1"/>
        </LinearGradientBrush>

        <!-- SCROLLBAR STYLE -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="T" Background="{DynamicResource DynamicAccent}" CornerRadius="4" Margin="2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="T" Property="Background" Value="#0284C7"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CLOSE BUTTON STYLE -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicSubText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AEF4444"/>
                                <Setter Property="Foreground" Value="{DynamicResource DynamicError}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ACCENT BUTTON STYLE -->
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ============================================ -->
    <!-- MAIN BORDER                                  -->
    <!-- ============================================ -->
    <Border Background="{DynamicResource DynamicWindowBg}" CornerRadius="16" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1.5" MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <!-- ============================================ -->
        <!-- MAIN GRID                                    -->
        <!-- ============================================ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================ -->
            <!-- HEADER                                       -->
            <!-- ============================================ -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#100EA5E9" Margin="0,0,10,0">
                            <TextBlock Text="&#xE704;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource SpeedTest_Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource DynamicMainText}"/>
                            <TextBlock Text="{DynamicResource SpeedTest_PoweredBy}" FontSize="10" Foreground="{DynamicResource DynamicSubText}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- ============================================ -->
            <!-- CONTENT - SCROLLVIEWER                      -->
            <!-- ============================================ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <StackPanel Margin="20,16,20,16">

                    <!-- ============================================ -->
                    <!-- GAUGE SECTION                               -->
                    <!-- ============================================ -->
                    <Border Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20,24" Margin="0,0,0,12">
                        <StackPanel>

                            <!-- STATUS TEXT -->
                            <TextBlock x:Name="StatusText" Text="{DynamicResource SpeedTest_Ready}" FontSize="13" Foreground="{DynamicResource DynamicSubText}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                            <!-- SPEEDTEST GAUGE -->
                            <Grid Width="280" Height="280" HorizontalAlignment="Center" Margin="0,0,0,20">

                                <!-- Track Background -->
                                <Path Stroke="{DynamicResource DynamicHoverBg}" StrokeThickness="14"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure x:Name="GaugeTrackFigure" StartPoint="72.8,207.2">
                                                <ArcSegment x:Name="GaugeTrackSegment"
                                                            Size="95,95"
                                                            Point="207.2,207.2"
                                                            IsLargeArc="True"
                                                            SweepDirection="Clockwise"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>

                                <!-- Progress Arc -->
                                <Path x:Name="GaugeArc" Stroke="{StaticResource AccentGradient}" StrokeThickness="14"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent">
                                    <Path.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#0EA5E9" Opacity="0.5"/>
                                    </Path.Effect>
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure x:Name="GaugeArcFigure" StartPoint="72.8,207.2">
                                                <ArcSegment x:Name="GaugeArcSegment"
                                                            Size="95,95"
                                                            Point="72.8,207.2"
                                                            IsLargeArc="False"
                                                            SweepDirection="Clockwise"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>

                                <!-- Ticks Canvas -->
                                <Canvas x:Name="GaugeTicksCanvas" Width="280" Height="280" IsHitTestVisible="False"/>

                                <!-- Needle -->
                                <Canvas Width="280" Height="280" IsHitTestVisible="False">
                                    <Path x:Name="GaugeNeedle" Fill="{DynamicResource DynamicAccent}"
                                          Data="M 139.5,55 L 140.5,55 L 144,138 L 136,138 Z">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="NeedleTransform" Angle="-135" CenterX="140" CenterY="140"/>
                                        </Path.RenderTransform>
                                        <Path.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#0EA5E9" Opacity="0.8"/>
                                        </Path.Effect>
                                    </Path>
                                </Canvas>

                                <!-- Center Hub -->
                                <Canvas Width="280" Height="280" IsHitTestVisible="False">
                                    <Ellipse Canvas.Left="132" Canvas.Top="132" Width="16" Height="16"
                                             Fill="{DynamicResource DynamicMainText}"/>
                                    <Ellipse Canvas.Left="136" Canvas.Top="136" Width="8" Height="8"
                                             Fill="{DynamicResource DynamicWindowBg}"/>
                                </Canvas>

                                <!-- Center Content -->
                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,15">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="GaugeValueText" Text="0.0" FontSize="32" FontWeight="Black"
                                                   Foreground="{DynamicResource DynamicMainText}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="GaugeUnitText" Text=" Mbps" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DynamicSubText}" VerticalAlignment="Bottom"
                                                   Margin="2,0,0,6"/>
                                    </StackPanel>
                                    <Border x:Name="GaugePhaseBadge" Background="#100EA5E9" CornerRadius="8" 
                                            Padding="12,3" Margin="0,4,0,0" HorizontalAlignment="Center">
                                        <TextBlock x:Name="GaugeLabelText" Text="READY" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource DynamicAccent}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- PROGRESS BAR -->
                            <Border Height="6" CornerRadius="3" Background="{DynamicResource DynamicHoverBg}" Margin="20,0,20,16" ClipToBounds="True">
                                <Border x:Name="ProgressBar" Height="6" Width="0" CornerRadius="3" HorizontalAlignment="Left">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#0EA5E9" Offset="0"/>
                                            <GradientStop Color="#22C55E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>

                            <!-- START BUTTON -->
                            <Button x:Name="StartButton" Width="150" Height="46" HorizontalAlignment="Center" Click="StartTest_Click" Style="{StaticResource AccentBtn}" Padding="20,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="StartBtnIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="StartBtnText" Text="{DynamicResource SpeedTest_StartTest}" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ============================================ -->
                    <!-- LIVE METRICS                                 -->
                    <!-- ============================================ -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- PING -->
                        <Border Grid.Column="0" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#108B5CF6" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE9F3;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="PingValue" Text="--" FontSize="22" FontWeight="Black" Foreground="{DynamicResource DynamicPurple}" HorizontalAlignment="Center"/>
                                <TextBlock Text="ms" FontSize="10" Foreground="{DynamicResource DynamicSubText}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource SpeedTest_Ping}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DynamicSubText}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- DOWNLOAD -->
                        <Border Grid.Column="2" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#1022C55E" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicSuccess}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="DownloadValue" Text="--" FontSize="22" FontWeight="Black" Foreground="{DynamicResource DynamicSuccess}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Mbps" FontSize="10" Foreground="{DynamicResource DynamicSubText}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource SpeedTest_Download}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DynamicSubText}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- UPLOAD -->
                        <Border Grid.Column="4" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#100EA5E9" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="UploadValue" Text="--" FontSize="22" FontWeight="Black" Foreground="{DynamicResource DynamicAccent}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Mbps" FontSize="10" Foreground="{DynamicResource DynamicSubText}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource SpeedTest_Upload}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DynamicSubText}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ============================================ -->
                    <!-- EXTRA METRICS                                -->
                    <!-- ============================================ -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- JITTER -->
                        <Border Grid.Column="0" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="7" Background="#10F97316" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource DynamicInfo}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource SpeedTest_Jitter}" FontSize="11" Foreground="{DynamicResource DynamicSubText}"/>
                                        <TextBlock x:Name="JitterValue" Text="-- ms" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource DynamicInfo}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border x:Name="JitterRating" Background="#10F97316" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="--" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DynamicInfo}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- PACKET LOSS -->
                        <Border Grid.Column="2" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="7" Background="#10EF4444" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource DynamicError}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource SpeedTest_PacketLoss}" FontSize="11" Foreground="{DynamicResource DynamicSubText}"/>
                                        <TextBlock x:Name="PacketLossValue" Text="-- %" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource DynamicError}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border x:Name="PacketLossRating" Background="#10EF4444" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="--" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DynamicError}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============================================ -->
                    <!-- CONNECTION INFO                              -->
                    <!-- ============================================ -->
                    <Border x:Name="InfoSection" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,12" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- HEADER -->
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="26" Height="26" CornerRadius="7" Background="#100EA5E9" Margin="0,0,8,0">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource DynamicAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource SpeedTest_ConnectionDetails}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DynamicAccent}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- LEFT COLUMN -->
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource SpeedTest_PublicIP}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource DynamicSubText}"/>
                                    <TextBlock x:Name="PublicIPText" Text="--" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DynamicMainText}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Provider" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource DynamicSubText}"/>
                                    <TextBlock x:Name="ProviderUsedText" Text="--" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DynamicMainText}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource SpeedTest_LocalIP}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource DynamicSubText}"/>
                                    <TextBlock x:Name="LocalIPText" Text="--" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DynamicMainText}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource SpeedTest_ConnectionType}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource DynamicSubText}"/>
                                    <TextBlock x:Name="ConnTypeText" Text="--" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DynamicMainText}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- RIGHT COLUMN -->
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource SpeedTest_ISP}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource DynamicSubText}"/>
                                    <TextBlock x:Name="ISPText" Text="--" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DynamicMainText}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource SpeedTest_Server}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource DynamicSubText}"/>
                                    <TextBlock x:Name="ServerText" Text="--" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DynamicMainText}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource SpeedTest_Location}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource DynamicSubText}"/>
                                    <TextBlock x:Name="LocationText" Text="--" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DynamicMainText}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- FOOTER -->
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource DynamicWindowBg}" CornerRadius="8" Padding="10,6" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource DynamicSubText}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource SpeedTest_TestedOn}" FontSize="11" Foreground="{DynamicResource DynamicSubText}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TestTimeText" Text="--" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DynamicMainText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ============================================ -->
                    <!-- RATING CARDS                                -->
                    <!-- ============================================ -->
                    <Border x:Name="RatingSection" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Visibility="Collapsed">
                        <StackPanel>

                            <!-- HEADER -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="26" Height="26" CornerRadius="7" Background="#1022C55E" Margin="0,0,8,0">
                                    <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource DynamicSuccess}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource SpeedTest_ConnectionRating}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DynamicAccent}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- CARDS GRID -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- GAMING CARD -->
                                <Border Grid.Column="0" CornerRadius="10" Background="#1022C55E" Padding="10,8" Margin="0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="GamingIcon" Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource DynamicSuccess}"/>
                                        <TextBlock Text="{DynamicResource SpeedTest_Gaming}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource DynamicSubText}" Margin="0,4,0,2"/>
                                        <TextBlock x:Name="GamingRating" Text="--" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource DynamicSuccess}"/>
                                        <Border x:Name="GamingScoreBar" Height="2" Width="0" CornerRadius="1" Background="{DynamicResource DynamicSuccess}" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>

                                <!-- STREAMING CARD -->
                                <Border Grid.Column="2" CornerRadius="10" Background="#100EA5E9" Padding="10,8" Margin="0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="StreamingIcon" Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource DynamicAccent}"/>
                                        <TextBlock Text="{DynamicResource SpeedTest_Streaming}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource DynamicSubText}" Margin="0,4,0,2"/>
                                        <TextBlock x:Name="StreamingRating" Text="--" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource DynamicAccent}"/>
                                        <Border x:Name="StreamingScoreBar" Height="2" Width="0" CornerRadius="1" Background="{DynamicResource DynamicAccent}" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>

                                <!-- VIDEO CALL CARD -->
                                <Border Grid.Column="4" CornerRadius="10" Background="#108B5CF6" Padding="10,8" Margin="0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="VideoCallIcon" Text="&#xE8AA;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource DynamicPurple}"/>
                                        <TextBlock Text="{DynamicResource SpeedTest_VideoCall}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource DynamicSubText}" Margin="0,4,0,2"/>
                                        <TextBlock x:Name="VideoCallRating" Text="--" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource DynamicPurple}"/>
                                        <Border x:Name="VideoCallScoreBar" Height="2" Width="0" CornerRadius="1" Background="{DynamicResource DynamicPurple}" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>

                                <!-- BROWSING CARD -->
                                <Border Grid.Column="6" CornerRadius="10" Background="#10F59E0B" Padding="10,8" Margin="0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="BrowsingIcon" Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource DynamicWarning}"/>
                                        <TextBlock Text="{DynamicResource SpeedTest_Browsing}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource DynamicSubText}" Margin="0,4,0,2"/>
                                        <TextBlock x:Name="BrowsingRating" Text="--" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource DynamicWarning}"/>
                                        <Border x:Name="BrowsingScoreBar" Height="2" Width="0" CornerRadius="1" Background="{DynamicResource DynamicWarning}" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================================ -->
            <!-- FOOTER                                       -->
            <!-- ============================================ -->
            <Border Grid.Row="2" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="0,1,0,0" Padding="16,10" CornerRadius="0,0,16,16">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource DynamicSuccess}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource AppName}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DynamicMainText}"/>
                        <TextBlock Text=" v1.0.0" FontSize="10" Foreground="{DynamicResource DynamicSubText}"/>
                    </StackPanel>
                    <Button Content="{DynamicResource Common_Close}" HorizontalAlignment="Right" Width="90" Height="32" Style="{StaticResource AccentBtn}" Padding="16,0" Click="Close_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>