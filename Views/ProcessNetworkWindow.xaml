<Window x:Class="TrafficMonitor.Views.ProcessNetworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ProcessNetwork_Title}"
        Width="900" Height="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        MinWidth="700"
        MinHeight="450"
        FlowDirection="{DynamicResource ApplicationFlowDirection}"
        TextElement.FontFamily="{DynamicResource GlobalFontFamily}"
        TextOptions.TextFormattingMode="Display">

    <!-- ============================================ -->
    <!-- WINDOW RESOURCES                             -->
    <!-- ============================================ -->
    <Window.Resources>

        <!-- ACCENT GRADIENT -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0EA5E9" Offset="0"/>
            <GradientStop Color="#0284C7" Offset="1"/>
        </LinearGradientBrush>

        <!-- CLOSE BUTTON STYLE -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicError}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AEF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SCROLLBAR STYLE -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#660EA5E9"
                                                        CornerRadius="3" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ============================================ -->
    <!-- MAIN BORDER                                  -->
    <!-- ============================================ -->
    <Border Background="{DynamicResource DynamicWindowBg}"
            CornerRadius="16"
            BorderBrush="{DynamicResource DynamicBorderBrush}"
            BorderThickness="1.5"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <!-- ============================================ -->
        <!-- MAIN GRID                                    -->
        <!-- ============================================ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================ -->
            <!-- HEADER                                       -->
            <!-- ============================================ -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource DynamicBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- ICON -->
                        <Border Width="34" Height="34" CornerRadius="9"
                                Background="#120EA5E9" Margin="0,0,12,0">
                            <TextBlock Text="&#xF156;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{DynamicResource DynamicAccent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- TITLE + SUBTITLE -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource ProcessNetwork_Title}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource DynamicMainText}"/>
                            <TextBlock x:Name="SubtitleText"
                                       Text="{DynamicResource ProcessNetwork_Monitoring}"
                                       FontSize="10"
                                       Foreground="{DynamicResource DynamicSubText}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- CLOSE BUTTON -->
                    <Button Style="{StaticResource CloseBtn}"
                            Content="&#xE8BB;"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="Close_Click"
                            ToolTip="{DynamicResource Common_Close}"/>
                </Grid>
            </Border>

            <!-- ============================================ -->
            <!-- TOOLBAR                                      -->
            <!-- ============================================ -->
            <Border Grid.Row="1"
                    Margin="16,12,16,0"
                    Background="{DynamicResource DynamicCardBg}"
                    BorderBrush="{DynamicResource DynamicBorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="14,10">
                <Grid>

                    <!-- LEFT SIDE -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- LIVE INDICATOR -->
                        <Border Background="#1022C55E" CornerRadius="8"
                                Padding="10,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LiveDot"
                                         Width="6" Height="6"
                                         Fill="{DynamicResource DynamicSuccess}"
                                         Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        From="1" To="0.2"
                                                        Duration="0:0:0.8"
                                                        AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="{DynamicResource ProcessNetwork_LIVE}"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource DynamicSuccess}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- PROCESS COUNT -->
                        <Border Background="#100EA5E9" CornerRadius="8"
                                Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C4;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="11"
                                           Foreground="{DynamicResource DynamicAccent}"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="ProcessCountText"
                                           Text="0 processes"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DynamicAccent}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT SIDE - SORT OPTIONS -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource ProcessNetwork_SortBy}"
                                   FontSize="11"
                                   Foreground="{DynamicResource DynamicSubText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <!-- SORT BY SPEED -->
                        <Border x:Name="SortSpeedBtn"
                                Background="{DynamicResource DynamicAccent}"
                                CornerRadius="7" Padding="10,6"
                                Cursor="Hand" Margin="0,0,6,0"
                                MouseLeftButtonDown="SortSpeed_Click"
                                ToolTip="{DynamicResource ProcessNetwork_SortBySpeed}">
                            <TextBlock Text="{DynamicResource ProcessNetwork_Speed}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>

                        <!-- SORT BY TOTAL -->
                        <Border x:Name="SortTotalBtn"
                                Background="{DynamicResource DynamicHoverBg}"
                                CornerRadius="7" Padding="10,6"
                                Cursor="Hand" Margin="0,0,6,0"
                                MouseLeftButtonDown="SortTotal_Click"
                                ToolTip="{DynamicResource ProcessNetwork_SortByTotal}">
                            <TextBlock Text="{DynamicResource ProcessNetwork_Total}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DynamicSubText}"/>
                        </Border>

                        <!-- SORT BY NAME -->
                        <Border x:Name="SortNameBtn"
                                Background="{DynamicResource DynamicHoverBg}"
                                CornerRadius="7" Padding="10,6"
                                Cursor="Hand"
                                MouseLeftButtonDown="SortName_Click"
                                ToolTip="{DynamicResource ProcessNetwork_SortByName}">
                            <TextBlock Text="{DynamicResource ProcessNetwork_Name}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource DynamicSubText}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================ -->
            <!-- LIST VIEW                                    -->
            <!-- ============================================ -->
            <Border Grid.Row="2"
                    Margin="16,12,16,0"
                    Background="{DynamicResource DynamicCardBg}"
                    BorderBrush="{DynamicResource DynamicBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ============================================ -->
                    <!-- LIST VIEW HEADER                            -->
                    <!-- ============================================ -->
                    <Border Grid.Row="0"
                            Background="#08FFFFFF"
                            BorderBrush="{DynamicResource DynamicBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ICON HEADER -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE160;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource DynamicSubText}"
                                           Margin="0,0,4,0"/>
                            </StackPanel>

                            <!-- PROCESS HEADER -->
                            <TextBlock Grid.Column="1" 
                                       Text="{DynamicResource ProcessNetwork_Process}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource DynamicSubText}"
                                       VerticalAlignment="Center"/>

                            <!-- UPLOAD HEADER -->
                            <StackPanel Grid.Column="2" 
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"
                                        Margin="0,0,20,0">
                                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11"
                                           Foreground="{DynamicResource DynamicAccent}"
                                           Margin="0,0,5,0"/>
                                <TextBlock Text="{DynamicResource ProcessNetwork_Upload}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource DynamicSubText}"/>
                            </StackPanel>

                            <!-- DOWNLOAD HEADER -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="0,0,30,0">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11"
                                           Foreground="{DynamicResource DynamicSuccess}"
                                           Margin="0,0,5,0"/>
                                <TextBlock Text="{DynamicResource ProcessNetwork_Download}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource DynamicSubText}"/>
                            </StackPanel>

                            <!-- TOTAL HEADER -->
                            <TextBlock Grid.Column="4" 
                                       Text="{DynamicResource ProcessNetwork_Total}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource DynamicSubText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="20,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- ============================================ -->
                    <!-- LIST VIEW DATA                              -->
                    <!-- ============================================ -->
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,4,0">
                        <ItemsControl x:Name="ProcessList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource DynamicBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Background="Transparent"
                                            Padding="14,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource DynamicHoverBg}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.3*"/>
                                                <ColumnDefinition Width="1.3*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- ICON -->
                                            <Border Grid.Column="0"
                                                    Width="32" Height="32"
                                                    CornerRadius="8"
                                                    Background="#100EA5E9"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <Image Source="{Binding IconSource}"
                                                       Width="20" Height="20"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>

                                            <!-- NAME + DESCRIPTION -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource DynamicMainText}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource DynamicSubText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- UPLOAD -->
                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding UploadText}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource DynamicAccent}"
                                                           HorizontalAlignment="Center"/>
                                                <Border Height="3" Width="80"
                                                        CornerRadius="1.5"
                                                        Background="#15FFFFFF"
                                                        Margin="0,4,0,0"
                                                        ClipToBounds="True">
                                                    <Border Height="3"
                                                            Width="{Binding UploadBarWidth}"
                                                            CornerRadius="1.5"
                                                            Background="{DynamicResource DynamicAccent}"
                                                            HorizontalAlignment="Left"
                                                            MaxWidth="80"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- DOWNLOAD -->
                                            <StackPanel Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DownloadText}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource DynamicSuccess}"
                                                           HorizontalAlignment="Center"/>
                                                <Border Height="3" Width="80"
                                                        CornerRadius="1.5"
                                                        Background="#15FFFFFF"
                                                        Margin="0,4,0,0"
                                                        ClipToBounds="True">
                                                    <Border Height="3"
                                                            Width="{Binding DownloadBarWidth}"
                                                            CornerRadius="1.5"
                                                            Background="{DynamicResource DynamicSuccess}"
                                                            HorizontalAlignment="Left"
                                                            MaxWidth="80"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- TOTAL -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding TotalText}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource DynamicMainText}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ============================================ -->
            <!-- FOOTER                                       -->
            <!-- ============================================ -->
            <Border Grid.Row="3"
                    Background="{DynamicResource DynamicCardBg}"
                    BorderBrush="{DynamicResource DynamicBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12"
                    Margin="0,12,0,0"
                    CornerRadius="0,0,16,16">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6"
                                 Fill="{DynamicResource DynamicSuccess}"
                                 Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource AppName}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DynamicMainText}"/>
                        <TextBlock Text=" v1.0.0"
                                   FontSize="10"
                                   Foreground="{DynamicResource DynamicSubText}"/>
                    </StackPanel>

                    <Button Content="{DynamicResource Common_Close}"
                            HorizontalAlignment="Right"
                            Width="90" Height="32"
                            Cursor="Hand"
                            Click="Close_Click"
                            ToolTip="{DynamicResource Common_Close}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{StaticResource AccentGradient}"
                                        CornerRadius="8">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="White"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>