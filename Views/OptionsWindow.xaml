<Window x:Class="TrafficMonitor.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource OptionSettings}"
        Width="780" Height="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="{DynamicResource ApplicationFlowDirection}"
        TextElement.FontFamily="{DynamicResource GlobalFontFamily}"
        TextOptions.TextFormattingMode="Display">

    <!-- ============================================ -->
    <!-- WINDOW RESOURCES                             -->
    <!-- ============================================ -->
    <Window.Resources>

        <!-- ACCENT GRADIENT -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0EA5E9" Offset="0"/>
            <GradientStop Color="#0284C7" Offset="1"/>
        </LinearGradientBrush>

        <!-- ============================================ -->
        <!-- SCROLLBAR STYLE                             -->
        <!-- ============================================ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="T" Background="{DynamicResource DynamicAccent}"
                                                        CornerRadius="4" Margin="2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="T" Property="Background" Value="#0284C7"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- CHECKBOX STYLE                              -->
        <!-- ============================================ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="18" Height="18" Margin="0,0,8,0">
                                <Border x:Name="box" Width="18" Height="18" CornerRadius="5"
                                        BorderThickness="1.5"
                                        BorderBrush="{DynamicResource DynamicBorderBrush}"
                                        Background="Transparent"/>
                                <TextBlock x:Name="chk" Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush"
                                        Value="{DynamicResource DynamicAccent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background"
                                        Value="{DynamicResource DynamicAccent}"/>
                                <Setter TargetName="box" Property="BorderBrush"
                                        Value="{DynamicResource DynamicAccent}"/>
                                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- RADIOBUTTON STYLE                           -->
        <!-- ============================================ -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="18" Height="18" Margin="0,0,8,0">
                                <Ellipse x:Name="outer" Width="18" Height="18"
                                         Stroke="{DynamicResource DynamicBorderBrush}"
                                         StrokeThickness="1.5" Fill="Transparent"/>
                                <Ellipse x:Name="inner" Width="8" Height="8"
                                         Fill="{DynamicResource DynamicAccent}"
                                         Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outer" Property="Stroke"
                                        Value="{DynamicResource DynamicAccent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="outer" Property="Stroke"
                                        Value="{DynamicResource DynamicAccent}"/>
                                <Setter TargetName="inner" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- TEXTBLOCK STYLE                             -->
        <!-- ============================================ -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ============================================ -->
        <!-- TEXTBOX STYLE                               -->
        <!-- ============================================ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource DynamicCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DynamicBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{DynamicResource DynamicAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- COMBOBOX STYLE                              -->
        <!-- ============================================ -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="8"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Grid Margin="12,0" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource DynamicSubText}" StrokeThickness="2" VerticalAlignment="Center" Margin="5,1,0,0" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="Fade">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="250">
                                    <Border x:Name="DropDownBorder" Background="{DynamicResource DynamicCardBg}" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource DynamicBorderBrush}" Margin="0,5,0,10" Opacity="0" RenderTransformOrigin="0.5,0">
                                        <Border.RenderTransform>
                                            <TranslateTransform Y="-10"/>
                                        </Border.RenderTransform>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel IsItemsHost="True" Margin="2"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="DropDownBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="DropDownBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="DropDownBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="DropDownBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-10" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX ITEM STYLE -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" CornerRadius="6" Margin="2" Background="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#100EA5E9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource DynamicAccent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- SLIDER STYLE - MODERN (BUG FIX)              -->
        <!-- ============================================ -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="{TemplateBinding Background}">

                            <Border Height="4" 
                                    Background="{DynamicResource DynamicBorderBrush}" 
                                    CornerRadius="2" 
                                    VerticalAlignment="Center"/>

                            <Track x:Name="PART_Track">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="16" Height="16" 
                                                        Background="White" 
                                                        BorderBrush="{DynamicResource DynamicAccent}" 
                                                        BorderThickness="2" 
                                                        CornerRadius="8" 
                                                        Cursor="Hand"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- DEFAULT BUTTON STYLE                        -->
        <!-- ============================================ -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DynamicCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DynamicBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource DynamicHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- ACCENT BUTTON STYLE                         -->
        <!-- ============================================ -->
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- CLOSE BUTTON STYLE                          -->
        <!-- ============================================ -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicError}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AEF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- TAB BUTTON STYLES                           -->
        <!-- ============================================ -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource DynamicHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabBtnActive" TargetType="Button" BasedOn="{StaticResource TabBtn}">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ============================================ -->
        <!-- SECTION CARD STYLE                          -->
        <!-- ============================================ -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DynamicCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DynamicBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- ============================================ -->
        <!-- SECTION TITLE STYLE - WITH VERTICAL ALIGNMENT -->
        <!-- ============================================ -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicAccent}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============================================ -->
        <!-- FIELD LABEL STYLE                           -->
        <!-- ============================================ -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicSubText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

    </Window.Resources>

    <!-- ============================================ -->
    <!-- MAIN BORDER                                  -->
    <!-- ============================================ -->
    <Border Background="{DynamicResource DynamicWindowBg}"
            CornerRadius="16"
            BorderBrush="{DynamicResource DynamicBorderBrush}"
            BorderThickness="1.5"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================ -->
            <!-- HEADER                                       -->
            <!-- ============================================ -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource DynamicBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="#100EA5E9"
                                Margin="0,0,10,0">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource DynamicAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource OptionSettings}"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource DynamicMainText}"/>
                    </StackPanel>
                    <Button x:Name="btnClose" Content="&#xE8BB;"
                            Style="{StaticResource CloseBtn}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="Cancel_Click"/>
                </Grid>
            </Border>

            <!-- ============================================ -->
            <!-- TABS - FIXED CENTERING                       -->
            <!-- ============================================ -->
            <Border Grid.Row="1"
                    Background="{DynamicResource DynamicCardBg}"
                    BorderBrush="{DynamicResource DynamicBorderBrush}"
                    BorderThickness="1" CornerRadius="10"
                    Margin="16,10,16,10" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <!-- TAB 1: MAIN WINDOW -->
                    <Button x:Name="MainWindowTab" Style="{StaticResource TabBtnActive}"
                            Click="MainWindowTab_Click" Margin="0,0,3,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Options_MainWindowSettings}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- TAB 2: TASKBAR WINDOW -->
                    <Button x:Name="TaskbarWindowTab" Style="{StaticResource TabBtn}"
                            Click="TaskbarWindowTab_Click" Margin="0,0,3,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Options_TaskbarWindowSettings}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- TAB 3: GENERAL -->
                    <Button x:Name="GeneralTab" Style="{StaticResource TabBtn}"
                            Click="GeneralTab_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8B8;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Options_GeneralSettings}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

            <!-- ============================================ -->
            <!-- CONTENT - SCROLLVIEWER                      -->
            <!-- ============================================ -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="16,0,16,0"
                          Padding="0,0,6,0">
                <StackPanel>

                    <!-- ============================================ -->
                    <!-- TAB 1: MAIN WINDOW                          -->
                    <!-- ============================================ -->
                    <StackPanel x:Name="MainWindowPanel">

                        <!-- COLOR & FONT -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="26" Height="26" CornerRadius="7"
                                            Background="#100EA5E9" Margin="0,0,8,0">
                                        <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{DynamicResource DynamicAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Options_ColorAndFont}"
                                               Style="{StaticResource SectionTitle}"
                                               Margin="0"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- FONT -->
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{DynamicResource Options_Font}"
                                               Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1"
                                                Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="{DynamicResource DynamicWindowBg}"
                                                BorderBrush="{DynamicResource DynamicBorderBrush}"
                                                BorderThickness="1" CornerRadius="7"
                                                Padding="10,5" Width="130" Margin="0,0,8,0">
                                            <TextBlock x:Name="FontNameText" Text="Segoe UI"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource DynamicMainText}"/>
                                        </Border>
                                        <TextBox x:Name="FontSizeBox" Width="52" Text="10"
                                                 HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <Button Grid.Row="0" Grid.Column="2"
                                            Content="{DynamicResource Options_ChooseFont}"
                                            Margin="8,0,0,8" Click="ChooseFont_Click"/>

                                    <!-- TEXT COLOR -->
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="{DynamicResource Options_TextColor}"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,12,8"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1"
                                                Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border BorderBrush="{DynamicResource DynamicBorderBrush}"
                                                BorderThickness="1" CornerRadius="7"
                                                Width="36" Height="28">
                                            <Button x:Name="TextColorBtn"
                                                    Width="34" Height="26"
                                                    Background="White"
                                                    BorderThickness="0"
                                                    Click="TextColor_Click"/>
                                        </Border>
                                        <CheckBox x:Name="BgTransparentCheck"
                                                  Content="{DynamicResource Options_BackgroundTransparent}"
                                                  Margin="12,0,0,0"
                                                  Checked="BgTransparentCheck_Changed"
                                                  Unchecked="BgTransparentCheck_Changed"/>
                                    </StackPanel>
                                    <Button Grid.Row="1" Grid.Column="2"
                                            Content="{DynamicResource Options_RestoreDefault}"
                                            Margin="8,0,0,8"
                                            Click="RestoreFontDefault_Click"/>

                                    <!-- BACKGROUND COLOR -->
                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Text="{DynamicResource Options_BackgroundColor}"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,12,8"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1"
                                                Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border BorderBrush="{DynamicResource DynamicBorderBrush}"
                                                BorderThickness="1" CornerRadius="7"
                                                Width="36" Height="28">
                                            <Button x:Name="BgColorBtn"
                                                    Width="34" Height="26"
                                                    Background="#FF2D2D2D"
                                                    BorderThickness="0"
                                                    Click="BgColor_Click"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- DISPLAY TEXT + NET SPEED UNIT -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <!-- DISPLAY TEXT -->
                            <Border Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="26" Height="26" CornerRadius="7"
                                                Background="#108B5CF6" Margin="0,0,8,0">
                                            <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" Foreground="{DynamicResource DynamicPurple}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Options_DisplayText}"
                                                   Style="{StaticResource SectionTitle}" Margin="0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="SwapUpDownCheck"
                                              Content="{DynamicResource Options_SwapUpDown}"/>
                                    <CheckBox x:Name="SpeedShortModeCheck"
                                              Content="{DynamicResource Options_SpeedShortMode}"/>
                                    <CheckBox x:Name="SeparateUnitCheck"
                                              Content="{DynamicResource Options_SeparateValueUnit}"/>
                                    <CheckBox x:Name="ShowToolTipCheck"
                                              Content="{DynamicResource Options_ShowToolTip}"/>
                                </StackPanel>
                            </Border>

                            <!-- NET SPEED UNIT -->
                            <Border Grid.Column="2" Style="{StaticResource SectionCard}" Margin="0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="26" Height="26" CornerRadius="7"
                                                Background="#10F97316" Margin="0,0,8,0">
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" Foreground="{DynamicResource DynamicWarning}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Options_NetSpeedUnit}"
                                                   Style="{StaticResource SectionTitle}" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Options_NetspeedUnit}"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,0,0,6"/>
                                    <RadioButton x:Name="UnitByteRadio"
                                                 Content="{DynamicResource Options_UnitByte}"
                                                 GroupName="SpeedUnit" IsChecked="True"/>
                                    <RadioButton x:Name="UnitBitRadio"
                                                 Content="{DynamicResource Options_UnitBit}"
                                                 GroupName="SpeedUnit"/>
                                    <TextBlock Text="{DynamicResource Options_UnitSelection}"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,10,0,6"/>
                                    <ComboBox x:Name="SpeedUnitCombo">
                                        <ComboBoxItem Content="{DynamicResource Options_AutoUnit}"/>
                                        <ComboBoxItem Content="KB/s"/>
                                        <ComboBoxItem Content="MB/s"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- WINDOW BEHAVIOR -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="26" Height="26" CornerRadius="7"
                                            Background="#1014B8A6" Margin="0,0,8,0">
                                        <TextBlock Text="&#xE78B;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{DynamicResource DynamicTeal}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Options_WindowBehavior}"
                                               Style="{StaticResource SectionTitle}" Margin="0"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <CheckBox x:Name="AlwaysOnTopCheck"
                                                  Content="{DynamicResource Options_AlwaysOnTop}"/>
                                        <CheckBox x:Name="LockWindowPosCheck"
                                                  Content="{DynamicResource Options_LockWindowPos}"/>
                                        <CheckBox x:Name="HideMainWindowCheck"
                                                  Content="{DynamicResource Options_HideMainWindowFullscreen}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <CheckBox x:Name="MousePenetrateCheck"
                                                  Content="{DynamicResource Options_MousePenetrate}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- DOUBLE CLICK -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                                    <TextBlock Text="{DynamicResource Options_DoubleClickAction}"
                                               Style="{StaticResource FieldLabel}"/>
                                </StackPanel>
                                <ComboBox x:Name="DoubleClickCombo" Width="300"
                                          HorizontalAlignment="Left">
                                    <ComboBoxItem Content="{DynamicResource Options_OpenConnectionDetails}"/>
                                    <ComboBoxItem Content="{DynamicResource Options_OpenHistoricalTraffic}"/>
                                    <ComboBoxItem Content="{DynamicResource Options_OpenOptions}"/>
                                    <ComboBoxItem Content="{DynamicResource Options_OpenTaskManager}"/>
                                    <ComboBoxItem Content="{DynamicResource Options_DoNothing}"/>
                                </ComboBox>

                                <!-- OPACITY SLIDER - MODIFIED (No Snap, Smooth) -->
                                <Grid Margin="0,15,0,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Options_Opacity}" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                                        <Border Background="#300EA5E9" Padding="8,3" CornerRadius="10" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}" 
                                                       FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DynamicAccent}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- ✅ MODIFIED: ModernSlider Style Applied -->
                                    <Slider x:Name="OpacitySlider" 
                                            Style="{StaticResource ModernSlider}"
                                            Width="220" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Minimum="0.3" Maximum="1.0" Value="1.0" 
                                            IsSnapToTickEnabled="False"
                                            ValueChanged="OpacitySlider_ValueChanged"/>
                                </Grid>

                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- ============================================ -->
                    <!-- TAB 2: TASKBAR WINDOW                       -->
                    <!-- ============================================ -->
                    <StackPanel x:Name="TaskbarWindowPanel" Visibility="Collapsed">

                        <!-- TASKBAR POSITION -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="26" Height="26" CornerRadius="7"
                                            Background="#100EA5E9" Margin="0,0,8,0">
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{DynamicResource DynamicAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Options_TaskbarPosition}"
                                               Style="{StaticResource SectionTitle}"
                                               Margin="0" />
                                </StackPanel>

                                <CheckBox x:Name="ShowTaskbarCheck"
                                          Content="{DynamicResource Options_ShowTaskbarWindow}"/>
                                <CheckBox x:Name="TaskbarOnLeftCheck"
                                          Content="{DynamicResource Options_TaskbarWindowOnLeft}"
                                          Margin="0,4,0,0"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{DynamicResource Options_HorizontalOffset}"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TaskbarOffsetXBox"
                                             Grid.Row="0" Grid.Column="1" Text="0"
                                             Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="{DynamicResource Options_VerticalOffset}"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TaskbarOffsetYBox"
                                             Grid.Row="1" Grid.Column="1" Text="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- TASKBAR DISPLAY + UNIT -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <!-- TASKBAR DISPLAY -->
                            <Border Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="26" Height="26" CornerRadius="7"
                                                Background="#108B5CF6" Margin="0,0,8,0">
                                            <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" Foreground="{DynamicResource DynamicPurple}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Options_TaskbarDisplay}"
                                                   Style="{StaticResource SectionTitle}" Margin="0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="TaskbarSwapUpDownCheck"
                                              Content="{DynamicResource Options_SwapUpDown}"/>
                                    <CheckBox x:Name="TaskbarShortModeCheck"
                                              Content="{DynamicResource Options_SpeedShortMode}"/>
                                    <CheckBox x:Name="TaskbarShowArrowsCheck"
                                              Content="{DynamicResource Options_ShowArrows}"/>
                                    <CheckBox x:Name="TaskbarSeparateUnitCheck"
                                              Content="{DynamicResource Options_SeparateValueUnit}"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                                        <TextBlock Text="{DynamicResource Options_DigitsNumber}"
                                                    Style="{StaticResource FieldLabel}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="DigitsNumberCombo" Width="80">
                                            <ComboBoxItem Content="3"/>
                                            <ComboBoxItem Content="4" IsSelected="True"/>
                                            <ComboBoxItem Content="5"/>
                                        </ComboBox>
                                        <TextBlock Text="{DynamicResource Options_Characters}"
                                                   Margin="8,0,0,0"
                                                   Foreground="{DynamicResource DynamicSubText}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- NET SPEED UNIT -->
                            <Border Grid.Column="2" Style="{StaticResource SectionCard}" Margin="0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="26" Height="26" CornerRadius="7"
                                                Background="#10F97316" Margin="0,0,8,0">
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" Foreground="{DynamicResource DynamicWarning}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Options_NetSpeedUnit}"
                                                   Style="{StaticResource SectionTitle}" Margin="0"/>
                                    </StackPanel>
                                    <RadioButton x:Name="TaskbarUnitByteRadio"
                                                 Content="{DynamicResource Options_UnitByte}"
                                                 GroupName="TBarUnit" IsChecked="True"/>
                                    <RadioButton x:Name="TaskbarUnitBitRadio"
                                                 Content="{DynamicResource Options_UnitBit}"
                                                 GroupName="TBarUnit"/>
                                    <TextBlock Text="{DynamicResource Options_DoubleClickAction}"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,12,0,6"/>
                                    <ComboBox x:Name="TaskbarDoubleClickCombo">
                                        <ComboBoxItem Content="{DynamicResource Options_OpenConnectionDetails}"/>
                                        <ComboBoxItem Content="{DynamicResource Options_OpenHistoricalTraffic}"/>
                                        <ComboBoxItem Content="{DynamicResource Options_OpenOptions}"/>
                                        <ComboBoxItem Content="{DynamicResource Options_DoNothing}"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </StackPanel>

                    <!-- ============================================ -->
                    <!-- TAB 3: GENERAL                              -->
                    <!-- ============================================ -->
                    <StackPanel x:Name="GeneralPanel" Visibility="Collapsed">

                        <!-- APPEARANCE -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="26" Height="26" CornerRadius="7"
                                            Background="#100EA5E9" Margin="0,0,8,0">
                                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{DynamicResource DynamicAccent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Options_Appearance}"
                                               Style="{StaticResource SectionTitle}" Margin="0"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Options_Theme}"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeLightRadio"
                                                 Content="{DynamicResource Options_ThemeLight}"
                                                 GroupName="Theme" Margin="0,0,20,0"
                                                 Checked="Theme_Changed"/>
                                    <RadioButton x:Name="ThemeDarkRadio"
                                                 Content="{DynamicResource Options_ThemeDark}"
                                                 GroupName="Theme" Margin="0,0,20,0"
                                                 Checked="Theme_Changed"/>
                                    <RadioButton x:Name="ThemeAutoRadio"
                                                 Content="{DynamicResource Options_ThemeAuto}"
                                                 GroupName="Theme"
                                                 Checked="Theme_Changed"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Options_Language}"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,14,0,8"/>
                                <ComboBox x:Name="LanguageCombo" Width="220"
          HorizontalAlignment="Left"
          SelectionChanged="Language_Changed"
          DisplayMemberPath="Text"
          SelectedValuePath="Tag">
                                    <ComboBox.Items>
                                        <ComboBoxItem Tag="en" Content="{DynamicResource EnglishUS}"/>
                                        <ComboBoxItem Tag="ar" Content="{DynamicResource Arabic}"/>
                                        <ComboBoxItem Tag="fr" Content="{DynamicResource French}"/>
                                        <ComboBoxItem Tag="es" Content="{DynamicResource Spanish}"/>
                                        <ComboBoxItem Tag="ru" Content="{DynamicResource Russian}"/>
                                    </ComboBox.Items>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- STARTUP + GENERAL SETTINGS -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- STARTUP SETTINGS - WITH CENTERED ALIGNMENT -->
                            <Border Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="7"
                                                Background="#1022C55E" Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" Foreground="{DynamicResource DynamicSuccess}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Options_Startup}"
                                                   Style="{StaticResource SectionTitle}" Margin="0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <CheckBox x:Name="StartWithWindowsCheck"
                                              Content="{DynamicResource Options_StartWithWindows}"/>
                                    <CheckBox x:Name="MinimizedStartCheck"
                                              Content="{DynamicResource Options_StartMinimized}"/>
                                    <CheckBox x:Name="ShowTrayIconCheck"
                                              Content="{DynamicResource Options_ShowTrayIcon}"/>
                                    <CheckBox x:Name="HardwareAccelCheck"
                                              Content="{DynamicResource Options_HardwareAcceleration}"/>
                                </StackPanel>
                            </Border>

                            <!-- MONITORING -->
                            <Border Grid.Column="2" Style="{StaticResource SectionCard}" Margin="0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="26" Height="26" CornerRadius="7"
                                                Background="#10EF4444" Margin="0,0,8,0">
                                            <TextBlock Text="&#xE9F3;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" Foreground="{DynamicResource DynamicError}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Options_Monitoring}"
                                                   Style="{StaticResource SectionTitle}" Margin="0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="{DynamicResource Options_UpdateInterval}"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="UpdateIntervalBox" Width="70" Text="1000"/>
                                        <TextBlock Text="ms" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource DynamicSubText}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoSelectConnCheck"
                                              Content="{DynamicResource Options_AutoSelect}"/>

                                    <Button Margin="0,10,0,0" HorizontalAlignment="Left"
                                            Click="SelectConnection_Click">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE839;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12" Margin="0,0,6,0"
                                                           Foreground="{DynamicResource DynamicAccent}"/>
                                                <TextBlock Text="{DynamicResource Options_SelectNetworkConnections}"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- NOTIFICATION -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="26" Height="26" CornerRadius="7"
                                            Background="#108B5CF6" Margin="0,0,8,0">
                                        <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{DynamicResource DynamicPurple}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Options_Notification}"
                                               Style="{StaticResource SectionTitle}" Margin="0"/>
                                </StackPanel>

                                <!-- TRAFFIC ALERT ROW -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="TrafficTipCheck"
                                              Content="{DynamicResource Options_NotifyTrafficReached}"
                                              Grid.Column="0"/>
                                    <TextBox x:Name="TrafficTipValueBox"
                                             Grid.Column="1" Text="200"
                                             Margin="8,0"/>
                                    <ComboBox x:Name="TrafficTipUnitCombo"
                                              Grid.Column="2">
                                        <ComboBoxItem Content="MB"/>
                                        <ComboBoxItem Content="GB"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- ============================================ -->
            <!-- FOOTER                                       -->
            <!-- ============================================ -->
            <Border Grid.Row="3"
                    Background="{DynamicResource DynamicCardBg}"
                    BorderBrush="{DynamicResource DynamicBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12"
                    CornerRadius="0,0,16,16">
                <Grid>
                    <!-- VERSION INFO -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource DynamicSuccess}"
                                 Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource TrafficMonitorVersion}"
                                   FontSize="10"
                                   Foreground="{DynamicResource DynamicSubText}"/>
                    </StackPanel>

                    <!-- BUTTONS -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource Options_Cancel}"
                                Width="90" Height="34"
                                Margin="0,0,8,0"
                                Click="Cancel_Click"/>
                        <Button Content="{DynamicResource Options_Save}"
                                Width="110" Height="34"
                                Style="{StaticResource AccentBtn}"
                                Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>