<Window x:Class="TrafficMonitor.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource History_WindowTitle}"
        Width="760" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="{DynamicResource ApplicationFlowDirection}"
        TextElement.FontFamily="{DynamicResource GlobalFontFamily}"
        TextOptions.TextFormattingMode="Display">

    <!-- ============================================ -->
    <!-- WINDOW RESOURCES                             -->
    <!-- ============================================ -->
    <Window.Resources>

        <!-- ACCENT GRADIENT -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0EA5E9" Offset="0"/>
            <GradientStop Color="#0284C7" Offset="1"/>
        </LinearGradientBrush>

        <!-- CLOSE BUTTON STYLE -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicError}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AEF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ACCENT BUTTON STYLE -->
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TAB BUTTON STYLE -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DynamicHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TAB BUTTON ACTIVE STYLE -->
        <Style x:Key="TabBtnActive" TargetType="Button" BasedOn="{StaticResource TabBtn}">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- NAVIGATION BUTTON STYLE -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DynamicCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DynamicBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DynamicHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX STYLE -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="8"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Grid Margin="12,0" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource DynamicSubText}" StrokeThickness="2" VerticalAlignment="Center" Margin="5,1,0,0" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="Fade">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="250">
                                    <Border x:Name="DropDownBorder" Background="{DynamicResource DynamicCardBg}" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource DynamicBorderBrush}" Margin="0,5,0,10" Opacity="0" RenderTransformOrigin="0.5,0">
                                        <Border.RenderTransform>
                                            <TranslateTransform Y="-10"/>
                                        </Border.RenderTransform>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel IsItemsHost="True" Margin="2"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="DropDownBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="DropDownBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="DropDownBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="DropDownBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-10" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX ITEM STYLE -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" CornerRadius="6" Margin="2" Background="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#100EA5E9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource DynamicAccent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SCROLLBAR STYLE -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Margin" Value="0,4,2,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="T" Background="#660EA5E9" CornerRadius="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="T" Property="Background" Value="#AA0EA5E9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ============================================ -->
    <!-- MAIN BORDER                                  -->
    <!-- ============================================ -->
    <Border Background="{DynamicResource DynamicWindowBg}"
            CornerRadius="16"
            BorderBrush="{DynamicResource DynamicBorderBrush}"
            BorderThickness="1.5"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================ -->
            <!-- HEADER                                       -->
            <!-- ============================================ -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="#100EA5E9" Margin="0,0,10,0">
                            <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource History_WindowTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource DynamicMainText}"/>
                    </StackPanel>
                    <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- ============================================ -->
            <!-- TABS                                         -->
            <!-- ============================================ -->
            <Border Grid.Row="1" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="10" Margin="16,10,16,10" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="ListViewTab" Content="{DynamicResource History_ListView}" Style="{StaticResource TabBtnActive}" Click="ListViewTab_Click" Margin="0,0,4,0"/>
                    <Button x:Name="CalendarViewTab" Content="{DynamicResource History_CalendarView}" Style="{StaticResource TabBtn}" Click="CalendarViewTab_Click"/>
                </StackPanel>
            </Border>

            <!-- ============================================ -->
            <!-- CONTENT                                      -->
            <!-- ============================================ -->
            <Grid Grid.Row="2" Margin="16,0,16,0">

                <!-- ============================================ -->
                <!-- LIST VIEW PANEL                             -->
                <!-- ============================================ -->
                <StackPanel x:Name="ListViewPanel">

                    <!-- TOP CONTROLS -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- VIEW TYPE -->
                        <Border Grid.Column="0" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" Background="#100EA5E9" CornerRadius="8" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource DynamicAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource History_ViewType}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource DynamicMainText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="ViewTypeCombo" Width="130" VerticalAlignment="Center" SelectionChanged="ViewTypeCombo_SelectionChanged">
                                    <ComboBoxItem Content="{DynamicResource History_DayView}" IsSelected="True"/>
                                    <ComboBoxItem Content="{DynamicResource History_MonthView}"/>
                                    <ComboBoxItem Content="{DynamicResource History_YearView}"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- SCALE -->
                        <Border Grid.Column="2" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" Background="#1022C55E" CornerRadius="8" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource DynamicSuccess}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource History_FigureViewScale}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource DynamicMainText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="ScaleCombo" Width="150" VerticalAlignment="Center" SelectionChanged="ScaleCombo_SelectionChanged">
                                    <ComboBoxItem Content="{DynamicResource History_LinearScale}"/>
                                    <ComboBoxItem Content="{DynamicResource History_LogarithmicScale}" IsSelected="True"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- LIST VIEW TABLE -->
                    <Border Background="{DynamicResource DynamicCardBg}" 
                            BorderBrush="{DynamicResource DynamicBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="12" 
                            Margin="0,0,0,10"
                            ClipToBounds="True">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- TABLE HEADER -->
                            <Border Grid.Row="0" 
                                    Background="#08FFFFFF"
                                    CornerRadius="12,12,0,0"
                                    BorderBrush="{DynamicResource DynamicBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,12">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource DynamicAccent}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource History_DateColumn}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource DynamicAccent}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource DynamicAccent}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource History_UploadColumn}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource DynamicAccent}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource DynamicSuccess}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource History_DownloadColumn}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource DynamicAccent}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE83B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource DynamicSubText}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource History_TotalTrafficColumn}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource DynamicAccent}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource DynamicSubText}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource History_FigureColumn}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource DynamicAccent}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- TABLE DATA -->
                            <ScrollViewer Grid.Row="1" 
                                          VerticalScrollBarVisibility="Auto" 
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="290"
                                          Padding="0,4,0,8">

                                <ItemsControl x:Name="HistoryList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent"
                                                    CornerRadius="8"
                                                    Margin="6,2"
                                                    Padding="4,10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource DynamicHoverBg}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding DateText}" Foreground="{DynamicResource DynamicMainText}" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" FontSize="11.5"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding UploadText}" Foreground="{DynamicResource DynamicAccent}" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11.5"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding DownloadText}" Foreground="{DynamicResource DynamicSuccess}" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11.5"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding TotalText}" Foreground="{DynamicResource DynamicMainText}" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" FontSize="12"/>

                                                    <Grid Grid.Column="4" HorizontalAlignment="Center">
                                                        <Border Width="130" Height="8" CornerRadius="4" Background="#15FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                                                            <Border Width="{Binding BarWidth}" Background="{Binding BarBrush}" CornerRadius="4" HorizontalAlignment="Left" MaxWidth="130"/>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ============================================ -->
                <!-- CALENDAR VIEW PANEL                         -->
                <!-- ============================================ -->
                <Grid x:Name="CalendarViewPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- CALENDAR CONTROLS -->
                    <Border Grid.Row="0" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" Background="#100EA5E9" CornerRadius="8" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ComboBox x:Name="YearCombo" Width="90" Height="32" VerticalAlignment="Center" SelectionChanged="CalendarRefresh" Margin="0,0,10,0"/>
                                <Border Width="32" Height="32" Background="#108B5CF6" CornerRadius="8" Margin="10,0,10,0">
                                    <TextBlock Text="&#xE163;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ComboBox x:Name="MonthCombo" Width="130" Height="32" VerticalAlignment="Center" SelectionChanged="CalendarRefresh"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="&#x276E;" Style="{StaticResource NavBtn}" Width="36" Margin="0,0,6,0" Click="PrevMonth_Click"/>
                                <Button Content="&#x276F;" Style="{StaticResource NavBtn}" Width="36" Margin="0,0,12,0" Click="NextMonth_Click"/>
                                <Button Content="{DynamicResource Common_Today}" Style="{StaticResource AccentBtn}" Width="Auto" Padding="16,0" Click="Today_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CALENDAR GRID + LEGEND -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <!-- CALENDAR -->
                        <Border Grid.Column="0" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,12,0">
                            <Grid x:Name="CalendarGrid" Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="35"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Border>

                        <!-- LEGEND -->
                        <Border Grid.Column="1" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="&#xE81D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource DynamicAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource History_Legend}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource DynamicMainText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#FF45A9E5"/>
                                    <TextBlock Text="{DynamicResource History_Legend_0_1GB}" FontSize="11" Margin="10,0,0,0" Foreground="{DynamicResource DynamicSubText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#FF6BBE5C"/>
                                    <TextBlock Text="{DynamicResource History_Legend_1_10GB}" FontSize="11" Margin="10,0,0,0" Foreground="{DynamicResource DynamicSubText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#FFE5C03A"/>
                                    <TextBlock Text="{DynamicResource History_Legend_10_100GB}" FontSize="11" Margin="10,0,0,0" Foreground="{DynamicResource DynamicSubText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#FFE57845"/>
                                    <TextBlock Text="{DynamicResource History_Legend_100GB_1TB}" FontSize="11" Margin="10,0,0,0" Foreground="{DynamicResource DynamicSubText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#FFAA2222"/>
                                    <TextBlock Text="{DynamicResource History_Legend_1TBplus}" FontSize="11" Margin="10,0,0,0" Foreground="{DynamicResource DynamicSubText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- MONTH SUMMARY -->
                    <Border Grid.Row="2" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,12,0,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Border Width="36" Height="36" Background="#100EA5E9" CornerRadius="10" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource DynamicAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource History_MonthTotalTraffic}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DynamicSubText}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicAccent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MonthUploadText" Text="0 MB" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource DynamicMainText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicSuccess}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MonthDownloadText" Text="0 MB" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource DynamicMainText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Width="1" Height="20" Background="{DynamicResource DynamicBorderBrush}" Margin="0,0,20,0"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE83B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicSubText}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MonthTotalText" Text="0 MB" FontSize="15" FontWeight="Black" Foreground="{DynamicResource DynamicMainText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============================================ -->
            <!-- FOOTER                                       -->
            <!-- ============================================ -->
            <Border Grid.Row="3" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="0,1,0,0" Padding="16,12" CornerRadius="0,0,16,16">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource DynamicSuccess}" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource TrafficMonitorVersion}" FontSize="10" Foreground="{DynamicResource DynamicSubText}"/>
                    </StackPanel>
                    <Button Content="{DynamicResource Common_OK}" HorizontalAlignment="Right" Style="{StaticResource AccentBtn}" Width="90" Click="Close_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>