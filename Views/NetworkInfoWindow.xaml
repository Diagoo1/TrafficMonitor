<Window x:Class="TrafficMonitor.Views.NetworkInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ConnectionDetails_Title}"
        Width="680" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FlowDirection="{DynamicResource ApplicationFlowDirection}"
        TextElement.FontFamily="{DynamicResource GlobalFontFamily}"
        TextOptions.TextFormattingMode="Display">

    <!-- ============================================ -->
    <!-- WINDOW RESOURCES                             -->
    <!-- ============================================ -->
    <Window.Resources>

        <!-- SCROLLBAR STYLE -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource DynamicAccent}"
                                                        CornerRadius="4" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CLOSE BUTTON STYLE -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicError}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="Segoe MDL2 Assets"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AEF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- INFO LABEL STYLE -->
        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DynamicSubText}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- INFO VALUE STYLE -->
        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

    </Window.Resources>

    <!-- ============================================ -->
    <!-- MAIN BORDER                                  -->
    <!-- ============================================ -->
    <Border Background="{DynamicResource DynamicWindowBg}"
            CornerRadius="16"
            BorderBrush="{DynamicResource DynamicBorderBrush}"
            BorderThickness="1.5"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============================================ -->
            <!-- HEADER                                       -->
            <!-- ============================================ -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource DynamicBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#100EA5E9"
                                Margin="0,0,10,0">
                            <TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource DynamicAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource ConnectionDetails_Title}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource DynamicMainText}"/>
                            <TextBlock Text="{DynamicResource ConnectionDetails_Subtitle}"
                                       FontSize="10"
                                       Foreground="{DynamicResource DynamicSubText}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource CloseBtn}"
                            Content="&#xE8BB;"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- ============================================ -->
            <!-- LIST                                        -->
            <!-- ============================================ -->
            <ScrollViewer Grid.Row="1" Margin="16,10,16,16" Padding="0,0,6,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ItemsControl x:Name="ConnectionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Padding="16"
                                    Background="{DynamicResource DynamicCardBg}"
                                    BorderBrush="{DynamicResource DynamicBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <StackPanel>

                                    <!-- HEADER: ICON + NAME + STATUS -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- TYPE ICON -->
                                        <Border Grid.Column="0"
                                                Width="38" Height="38"
                                                CornerRadius="10"
                                                Background="#100EA5E9"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="{Binding TypeIcon}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource DynamicAccent}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- NAME + TYPE -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{DynamicResource DynamicMainText}"/>
                                            <TextBlock Text="{Binding Type}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource DynamicSubText}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- STATUS PILL -->
                                        <Border Grid.Column="2"
                                                x:Name="StatusBadge"
                                                CornerRadius="10"
                                                Padding="9,4"
                                                VerticalAlignment="Center"
                                                Background="#1022C55E">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="StatusDot" 
                                                         Width="6" Height="6"
                                                         Fill="{DynamicResource DynamicSuccess}"
                                                         Margin="0,0,5,0"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock x:Name="StatusText"
                                                           Text="{DynamicResource ConnectionDetails_StatusActive}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource DynamicSuccess}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- DIVIDER -->
                                    <Border Height="1"
                                            Background="{DynamicResource DynamicBorderBrush}"
                                            Margin="0,0,0,12"/>

                                    <!-- ============================================ -->
                                    <!-- INFO GRID                                    -->
                                    <!-- ============================================ -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- LEFT COLUMN -->
                                        <StackPanel Grid.Column="0">

                                            <!-- DESCRIPTION -->
                                            <StackPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                               Foreground="{DynamicResource DynamicAccent}" Margin="0,0,5,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource ConnectionDetails_Description}" Style="{StaticResource InfoLabelStyle}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource InfoValueStyle}"/>
                                            </StackPanel>

                                            <!-- IP ADDRESS -->
                                            <StackPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                               Foreground="{DynamicResource DynamicAccent}" Margin="0,0,5,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource ConnectionDetails_IPAddress}" Style="{StaticResource InfoLabelStyle}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding IPAddress}" Style="{StaticResource InfoValueStyle}"/>
                                            </StackPanel>

                                            <!-- SUBNET MASK -->
                                            <StackPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                               Foreground="{DynamicResource DynamicAccent}" Margin="0,0,5,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource ConnectionDetails_SubnetMask}" Style="{StaticResource InfoLabelStyle}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SubnetMask}" Style="{StaticResource InfoValueStyle}"/>
                                            </StackPanel>

                                            <!-- GATEWAY -->
                                            <StackPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                               Foreground="{DynamicResource DynamicAccent}" Margin="0,0,5,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource ConnectionDetails_DefaultGateway}" Style="{StaticResource InfoLabelStyle}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Gateway}" Style="{StaticResource InfoValueStyle}"/>
                                            </StackPanel>

                                            <!-- DNS SERVERS -->
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                               Foreground="{DynamicResource DynamicAccent}" Margin="0,0,5,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource ConnectionDetails_DNSServers}" Style="{StaticResource InfoLabelStyle}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DnsServers}" Style="{StaticResource InfoValueStyle}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- RIGHT COLUMN -->
                                        <StackPanel Grid.Column="2">

                                            <!-- MAC ADDRESS -->
                                            <StackPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                               Foreground="{DynamicResource DynamicPurple}" Margin="0,0,5,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource ConnectionDetails_MACAddress}" Style="{StaticResource InfoLabelStyle}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding MAC}" Style="{StaticResource InfoValueStyle}"/>
                                            </StackPanel>

                                            <!-- LINK SPEED -->
                                            <StackPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="&#xE89A;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                               Foreground="{DynamicResource DynamicSuccess}" Margin="0,0,5,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource ConnectionDetails_LinkSpeed}" Style="{StaticResource InfoLabelStyle}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SpeedText}" 
                                                           Foreground="{DynamicResource DynamicSuccess}"
                                                           FontWeight="Bold" FontSize="11.5"/>
                                            </StackPanel>

                                            <!-- BYTES RECEIVED -->
                                            <StackPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                               Foreground="{DynamicResource DynamicSuccess}" Margin="0,0,5,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource ConnectionDetails_BytesReceived}" Style="{StaticResource InfoLabelStyle}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding BytesReceivedText}" Style="{StaticResource InfoValueStyle}"/>
                                            </StackPanel>

                                            <!-- BYTES SENT -->
                                            <StackPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                               Foreground="{DynamicResource DynamicAccent}" Margin="0,0,5,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource ConnectionDetails_BytesSent}" Style="{StaticResource InfoLabelStyle}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding BytesSentText}" Style="{StaticResource InfoValueStyle}"/>
                                            </StackPanel>

                                            <!-- CONNECTION TYPE -->
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                               Foreground="{DynamicResource DynamicInfo}" Margin="0,0,5,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource ConnectionDetails_ConnectionType}" Style="{StaticResource InfoLabelStyle}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Type}" Style="{StaticResource InfoValueStyle}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ============================================ -->
                            <!-- DATA TEMPLATE TRIGGERS                     -->
                            <!-- ============================================ -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="#15808080"/>
                                    <Setter TargetName="StatusText" Property="Text" Value="{DynamicResource ConnectionDetails_StatusInactive}"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource DynamicSubText}"/>
                                    <Setter TargetName="StatusDot" Property="Fill" Value="#808080"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </ScrollViewer>
        </Grid>
    </Border>
</Window>