<Window x:Class="TrafficMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource MainWindow_Title}"
        Width="320" Height="265"
        MinWidth="280" MinHeight="265"
        WindowStartupLocation="Manual"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FlowDirection="{DynamicResource ApplicationFlowDirection}"
        TextElement.FontFamily="{DynamicResource GlobalFontFamily}"
        TextOptions.TextFormattingMode="Display">

    <!-- ============================================ -->
    <!-- WINDOW RESOURCES                             -->
    <!-- ============================================ -->
    <Window.Resources>

        <!-- ACCENT GRADIENT -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0EA5E9" Offset="0"/>
            <GradientStop Color="#0284C7" Offset="1"/>
        </LinearGradientBrush>

        <!-- ============================================ -->
        <!-- ICON BUTTON STYLE                           -->
        <!-- ============================================ -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource DynamicSubText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DynamicHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- CLOSE BUTTON STYLE                          -->
        <!-- ============================================ -->
        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Foreground" Value="{DynamicResource DynamicSubText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AEF4444"/>
                                <Setter Property="Foreground" Value="{DynamicResource DynamicError}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ============================================ -->
    <!-- MAIN BORDER                                  -->
    <!-- ============================================ -->
    <Border x:Name="MainBorder"
            Background="{DynamicResource DynamicWindowBg}"
            BorderBrush="{DynamicResource DynamicBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="16"
            MouseLeftButtonDown="Window_MouseDown"
            Cursor="Arrow">

        <DockPanel>

            <!-- ============================================ -->
            <!-- TITLE BAR                                    -->
            <!-- ============================================ -->
            <Border DockPanel.Dock="Top"
                    Height="50"
                    Background="Transparent"
                    BorderBrush="{DynamicResource DynamicBorderBrush}"
                    BorderThickness="0,0,0,1">

                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- APP ICON -->
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#150EA5E9" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource DynamicAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- TITLE + STATUS -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource MainWindow_Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource DynamicMainText}" LineHeight="16" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource DynamicSuccess}" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="#22C55E" Opacity="0.9"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="ConnectionText" Text="{DynamicResource Network}" FontSize="11" Foreground="{DynamicResource DynamicSubText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- BUTTONS -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnMenu" Content="&#xE712;" Style="{StaticResource IconBtn}" Click="MenuButton_Click" ToolTip="{DynamicResource MainWindow_Menu}" Margin="0,0,2,0"/>
                        <Button x:Name="btnClose" Content="&#xE8BB;" Style="{StaticResource CloseBtn}" Click="Close_Click" ToolTip="{DynamicResource MainWindow_Close}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================ -->
            <!-- CONTENT                                      -->
            <!-- ============================================ -->
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ============================================ -->
                <!-- UPLOAD                                       -->
                <!-- ============================================ -->
                <Border Grid.Row="0" Margin="0,0,0,6" Padding="14,0" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="9" Background="#120EA5E9" Margin="0,0,12,0">
                                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource MainWindow_UploadLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DynamicSubText}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="UploadText" Text="0 B/s" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DynamicAccent}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- DOWNLOAD                                     -->
                <!-- ============================================ -->
                <Border Grid.Row="1" Margin="0,0,0,6" Padding="14,0" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="9" Background="#1222C55E" Margin="0,0,12,0">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicSuccess}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource MainWindow_DownloadLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DynamicSubText}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="DownloadText" Text="0 B/s" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DynamicSuccess}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- FOOTER (TODAY & CONNECTION)                  -->
                <!-- ============================================ -->
                <Border Grid.Row="2" Padding="14,0" Background="{DynamicResource DynamicCardBg}" BorderBrush="{DynamicResource DynamicBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid>

                        <!-- TODAY SECTION -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="9" Background="#10F97316" Margin="0,0,12,0">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DynamicWarning}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource MainWindow_TodayLabel}" FontSize="12" Foreground="{DynamicResource DynamicSubText}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TodayText" Text="0 MB" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DynamicWarning}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- CONNECTION BADGE -->
                        <Border Background="#100EA5E9" CornerRadius="8" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ConnectionBadgeIcon" Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource DynamicAccent}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ConnectionBadgeText" Text="{DynamicResource Network}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DynamicAccent}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

            </Grid>
        </DockPanel>
    </Border>
</Window>