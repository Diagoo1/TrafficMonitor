<Window x:Class="TrafficMonitor.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="95" Height="34"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FlowDirection="{DynamicResource ApplicationFlowDirection}">

    <Border x:Name="RootBorder" Background="#01000000" Padding="3,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============================================ -->
            <!-- UPLOAD                                       -->
            <!-- ============================================ -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">

                <TextBlock x:Name="UploadArrow"
                           Text="{DynamicResource Taskbar_UploadArrow}"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="{Binding ElementName=RootBorder, Path=Tag}"
                           VerticalAlignment="Center"
                           Margin="0,0,2,0"/>

                <TextBlock Text="{DynamicResource Taskbar_Separator}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{Binding ElementName=RootBorder, Path=Tag}"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>

                <TextBlock x:Name="UploadText"
                           Text="0.00 KB/s"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{Binding ElementName=RootBorder, Path=Tag}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ============================================ -->
            <!-- DOWNLOAD                                     -->
            <!-- ============================================ -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">

                <TextBlock x:Name="DownloadArrow"
                           Text="{DynamicResource Taskbar_DownloadArrow}"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           FontWeight="Normal"
                           Foreground="{Binding ElementName=RootBorder, Path=Tag}"
                           VerticalAlignment="Center"
                           Margin="0,0,2,0"/>

                <TextBlock Text="{DynamicResource Taskbar_Separator}"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{Binding ElementName=RootBorder, Path=Tag}"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>

                <TextBlock x:Name="DownloadText"
                           Text="0.00 KB/s"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{Binding ElementName=RootBorder, Path=Tag}"
                           VerticalAlignment="Center"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>