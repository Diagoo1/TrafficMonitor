<Application x:Class="TrafficMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             ShutdownMode="OnExplicitShutdown"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Lang/Lang-EN.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================================ -->
            <!-- GLOBAL FONT FAMILY (Dynamic)                 -->
            <!-- ============================================ -->
            <FontFamily x:Key="GlobalFontFamily">Segoe UI</FontFamily>

            <!-- Per-language fonts -->
            <FontFamily x:Key="Font_AR">pack://application:,,,/Fonts/#29LT Bukra Regular</FontFamily>
            <FontFamily x:Key="Font_EN">pack://application:,,,/Fonts/#Satoshi Variable</FontFamily>
            <FontFamily x:Key="Font_FR">pack://application:,,,/Fonts/#Satoshi Variable</FontFamily>
            <FontFamily x:Key="Font_ES">pack://application:,,,/Fonts/#Satoshi Variable</FontFamily>
            <FontFamily x:Key="Font_RU">pack://application:,,,/Fonts/#Stem-Regular</FontFamily>

            <!-- ============================================ -->
            <!-- GLOBAL STYLES WITH DYNAMIC FONT              -->
            <!-- ============================================ -->
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            </Style>
            <Style TargetType="{x:Type Button}">
                <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            </Style>
            <Style TargetType="{x:Type Label}">
                <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            </Style>
            <Style TargetType="{x:Type CheckBox}">
                <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            </Style>

            <!-- ============================================ -->
            <!-- LIGHT MODE COLORS                            -->
            <!-- ============================================ -->
            <SolidColorBrush x:Key="WindowBg" Color="#F1F5F9"/>
            <SolidColorBrush x:Key="SidebarBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="MainText" Color="#1E293B"/>
            <SolidColorBrush x:Key="SubText" Color="#64748B"/>
            <SolidColorBrush x:Key="Accent" Color="#0EA5E9"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
            <SolidColorBrush x:Key="Border" Color="#E2E8F0"/>
            <SolidColorBrush x:Key="HoverBg" Color="#E2E8F0"/>
            <SolidColorBrush x:Key="TotalCardBg" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="Success" Color="#22C55E"/>
            <SolidColorBrush x:Key="Warning" Color="#F59E0B"/>
            <SolidColorBrush x:Key="Error" Color="#EF4444"/>
            <SolidColorBrush x:Key="Info" Color="#F97316"/>
            <SolidColorBrush x:Key="Purple" Color="#8B5CF6"/>
            <SolidColorBrush x:Key="Pink" Color="#EC4899"/>
            <SolidColorBrush x:Key="Indigo" Color="#6366F1"/>
            <SolidColorBrush x:Key="Teal" Color="#14B8A6"/>

            <!-- ============================================ -->
            <!-- DARK MODE COLORS                             -->
            <!-- ============================================ -->
            <SolidColorBrush x:Key="WindowBgDark" Color="#202020"/>
            <SolidColorBrush x:Key="SidebarBgDark" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="CardBgDark" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="MainTextDark" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SubTextDark" Color="#A0A0A0"/>
            <SolidColorBrush x:Key="AccentDark" Color="#0EA5E9"/>
            <SolidColorBrush x:Key="BorderBrushDark" Color="#404040"/>
            <SolidColorBrush x:Key="BorderDark" Color="#404040"/>
            <SolidColorBrush x:Key="HoverBgDark" Color="#404040"/>
            <SolidColorBrush x:Key="TotalCardBgDark" Color="#252525"/>
            <SolidColorBrush x:Key="SuccessDark" Color="#22C55E"/>
            <SolidColorBrush x:Key="WarningDark" Color="#F59E0B"/>
            <SolidColorBrush x:Key="ErrorDark" Color="#EF4444"/>
            <SolidColorBrush x:Key="InfoDark" Color="#F97316"/>
            <SolidColorBrush x:Key="PurpleDark" Color="#8B5CF6"/>
            <SolidColorBrush x:Key="PinkDark" Color="#EC4899"/>
            <SolidColorBrush x:Key="IndigoDark" Color="#6366F1"/>
            <SolidColorBrush x:Key="TealDark" Color="#14B8A6"/>

            <!-- ============================================ -->
            <!-- DYNAMIC RESOURCES (Default: Light)           -->
            <!-- ============================================ -->
            <SolidColorBrush x:Key="DynamicWindowBg" Color="#F1F5F9"/>
            <SolidColorBrush x:Key="DynamicSidebarBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DynamicCardBg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="DynamicMainText" Color="#1E293B"/>
            <SolidColorBrush x:Key="DynamicSubText" Color="#64748B"/>
            <SolidColorBrush x:Key="DynamicAccent" Color="#0EA5E9"/>
            <SolidColorBrush x:Key="DynamicBorderBrush" Color="#E2E8F0"/>
            <SolidColorBrush x:Key="DynamicBorder" Color="#E2E8F0"/>
            <SolidColorBrush x:Key="DynamicHoverBg" Color="#E2E8F0"/>
            <SolidColorBrush x:Key="DynamicTotalCardBg" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="DynamicSuccess" Color="#22C55E"/>
            <SolidColorBrush x:Key="DynamicWarning" Color="#F59E0B"/>
            <SolidColorBrush x:Key="DynamicError" Color="#EF4444"/>
            <SolidColorBrush x:Key="DynamicInfo" Color="#F97316"/>
            <SolidColorBrush x:Key="DynamicPurple" Color="#8B5CF6"/>
            <SolidColorBrush x:Key="DynamicPink" Color="#EC4899"/>
            <SolidColorBrush x:Key="DynamicIndigo" Color="#6366F1"/>
            <SolidColorBrush x:Key="DynamicTeal" Color="#14B8A6"/>

            <!-- ============================================ -->
            <!-- GRADIENTS                                    -->
            <!-- ============================================ -->
            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0EA5E9" Offset="0"/>
                <GradientStop Color="#0284C7" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#22C55E" Offset="0"/>
                <GradientStop Color="#16A34A" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="ErrorGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EF4444" Offset="0"/>
                <GradientStop Color="#DC2626" Offset="1"/>
            </LinearGradientBrush>

            <!-- ============================================ -->
            <!-- FLOW DIRECTION                               -->
            <!-- ============================================ -->
            <FlowDirection x:Key="ApplicationFlowDirection">LeftToRight</FlowDirection>

            <!-- ============================================ -->
            <!-- EFFECTS                                      -->
            <!-- ============================================ -->
            <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="0" Opacity="0.08" Color="#000000"/>

            <!-- ============================================ -->
            <!-- CONTEXT MENU & MENU ITEM STYLES (Dark/Light) -->
            <!-- ============================================ -->
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{DynamicResource DynamicCardBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DynamicBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" 
                                                      Opacity="0.15" Color="#000000"/>
                                </Border.Effect>
                                <ItemsPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource DynamicMainText}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,7,14,7"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="7" Margin="2,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Icon -->
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding Icon}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                    <!-- Header -->
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"/>
                                    <!-- Submenu Arrow -->
                                    <Path Grid.Column="2"
                                          x:Name="Arrow"
                                          Data="M 0 0 L 4 4 L 0 8"
                                          Stroke="{DynamicResource DynamicSubText}"
                                          StrokeThickness="1.5"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"
                                          Visibility="Collapsed"/>
                                    <!-- Submenu Popup -->
                                    <Popup Grid.Column="1"
                                           x:Name="PART_Popup"
                                           Placement="Right"
                                           IsOpen="{TemplateBinding IsSubmenuOpen}"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Background="{DynamicResource DynamicCardBg}"
                                                BorderBrush="{DynamicResource DynamicBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="4"
                                                Margin="4,0,0,0">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="20" ShadowDepth="0"
                                                                  Opacity="0.15" Color="#000000"/>
                                            </Border.Effect>
                                            <ItemsPresenter/>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background"
                                            Value="{DynamicResource DynamicHoverBg}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#100EA5E9"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DynamicAccent}"/>
                                </Trigger>
                                <Trigger Property="HasItems" Value="True">
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Separator">
                <Setter Property="Background" Value="{DynamicResource DynamicBorder}"/>
                <Setter Property="Height" Value="1"/>
                <Setter Property="Margin" Value="8,3"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Background="{TemplateBinding Background}" Margin="{TemplateBinding Margin}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>